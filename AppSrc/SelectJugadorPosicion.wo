// C:\DataFlex Projects\FutbollWebApp\AppSrc\SelectJugadorPosicion.wo
// SelectJugadorPosicion
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd
Use cposicionDataDictionary.dd
Use cjugadorposicionDataDictionary.dd
Use cWebButton.pkg


Object oSelectJugadorPosicion is a cWebView
    Set psCaption to "SelectJugadorPosicion"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Object oposicion_DD is a cposicionDataDictionary
    End_Object 

    Object ojugadorposicion_DD is a cjugadorposicionDataDictionary
        Set DDO_Server To ojugador_DD
        Set DDO_Server to oposicion_DD
        Set Constrain_File to jugador.File_Number
    End_Object 
    
    Object oPosicionesTotales_DD is a cposicionDataDictionary
    End_Object

    Set Main_DD To ojugadorposicion_DD
    Set Server  To ojugadorposicion_DD

    Object oListaPosicionesDisponibles is a cWebList
        Set piColumnSpan to 4
        Set Server to oPosicionesTotales_DD 
        Object oWebColumn1 is a cWebColumn
            Set psCaption to "Posiciones disponibles"
            Set piWidth to 50
            Entry_Item posicion.Nombre
        End_Object
    End_Object

    Object oBtnEliminarPosicion is a cWebButton
        Set psCaption to "<<"
        Set piColumnIndex to 4
        Set pbServerOnClick to True
    
        Procedure OnClick
            String sCurRi
            RowID riCurRi
            Boolean bFound

            WebGet psCurrentRowId of oListaPosicionesJugador to sCurRi
            Move (DeserializeRowID(sCurRi)) to riCurRi
            Move (FindByRowID(jugadorposicion.File_Number, riCurRi)) to bFound

            If (bFound) Begin
                Send FindByRowId of ojugadorposicion_DD jugadorposicion.File_Number riCurRi
                Send Request_Delete of ojugadorposicion_DD
                Send RefreshListFromDD of oListaPosicionesJugador
            End
        End_Procedure
    End_Object

    Object oBtnAnadirPosicion is a cWebButton
        Set psCaption to ">>"
        Set piColumnIndex to 5
        Set pbServerOnClick to True
    
        Procedure OnClick
            String sCurRi
            RowID riCurRi
            Integer iPosicionID
            Integer iJugadorID
            Boolean bEncontrado
            Boolean bFound

            WebGet psCurrentRowId of oListaPosicionesDisponibles to sCurRi
            Move (DeserializeRowID(sCurRi)) to riCurRi
            Move (FindByRowID(posicion.File_Number, riCurRi)) to bFound
            If (not(bFound)) Procedure_Return
            Move posicion.ID to iPosicionID

            Get Field_Current_Value of ojugador_DD Field jugador.ID to iJugadorID

            Send Clear of ojugadorposicion_DD

            Move iPosicionID to jugadorposicion.PosicionID
            Move iJugadorID to jugadorposicion.JugadorID

            Send Request_Find of ojugadorposicion_DD EQ jugadorposicion.File_Number 2
            Move (Found) to bEncontrado

            If (bEncontrado) Begin
                Send UserError "Esta posición ya está seleccionada"
            End
            Else Begin
                Move iPosicionID to posicion.ID
                Send Request_Find of oposicion_DD EQ posicion.File_Number 1
                If (Found) Begin
                    Send Request_Save of ojugadorposicion_DD
                    Send RefreshListFromDD of oListaPosicionesJugador
                End
            End
        End_Procedure
    End_Object

    Object oListaPosicionesJugador is a cWebList
        Set piColumnSpan to 5
        Set piColumnIndex to 6
        Set Server to ojugadorposicion_DD
        Object oWebColumn2 is a cWebColumn
            Set psCaption to "Posiciones del Jugador"
            Set piWidth to 50
            Entry_Item posicion.Nombre
        End_Object
    End_Object

    
   Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Forward Send OnNavigateForward NavigateData hoInvokingView hoInvokingObject

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent lookup from a Zoom
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a probably a main-file lookup from a Zoom
                Case Break

            Case Else // must be nfUndefined
                // This may be the start of a drilldown query or this may be used for some kind of custom query.

        Case End
        
        Send Find of oPosicionesTotales_DD FIRST_RECORD 1
        Send GridRefresh of oListaPosicionesDisponibles
        Send GridRefresh of oListaPosicionesJugador
    End_Procedure


End_Object 
