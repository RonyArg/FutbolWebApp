37604>>>        WebSet pbRender of oEditBtn to False
37605>>>        WebSet pbRender of oSaveBtn to False
37606>>>        WebSet pbRender of oCancelChangesBtn to False
37607>>>        WebSet pbRender of oDeleteBtn to False
37608>>>
37608>>>        If (NavigateData.bReadOnly) Begin
